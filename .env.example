# ==========================================
# FitBuddy Environment Configuration
# ==========================================

# Gemini API key
# Get one from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here

# Set to false when using real Gemini AI.
# Set to true to run the project without an API key.
DEMO_MODE=true

# Gemini models
GEMINI_WORKOUT_MODEL=gemini-2.0-flash
GEMINI_TIP_MODEL=gemini-2.0-flash

# SQLite database
DATABASE_URL=sqlite:///./fitbuddy.db

# Application
APP_NAME=FitBuddy
DEBUG=true
